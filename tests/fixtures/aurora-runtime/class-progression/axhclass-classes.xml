			<!-- Source rule: Choose 1 at Mistkeeper level 13. -->
<select type="Class Feature" name="Grand Hex (Mistkeeper, level 13)" supports="ID_AXHCLASS_CLASS_CHOICE_MISTKEEPER_GRAND_HEX" level="13" />
			<!-- Source rule: Choose 1 at Mistkeeper level 15. -->
<select type="Class Feature" name="Grand Hex (Mistkeeper, level 15)" supports="ID_AXHCLASS_CLASS_CHOICE_MISTKEEPER_GRAND_HEX" level="15" />
